# Пароль для страницы /admin.html (придумай длинный)
ADMIN_TOKEN=

# База данных: Upstash Redis (Vercel → Storage → Marketplace → Upstash Redis).
# Vercel сам добавит KV_REST_API_URL и KV_REST_API_TOKEN (или UPSTASH_REDIS_REST_*).

# Почта (SMTP). Пример для Gmail: smtp.gmail.com, порт 465, пароль приложения.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=santa.secret.office@gmail.com
SMTP_PASS=
MAIL_FROM="Тайный Санта <santa.secret.office@gmail.com>"

# Данные для письма (необязательно)
BUDGET=до 1 500 ₽
GIFT_DEADLINE=18 декабря
PARTY_DATE=27 декабря, корпоратив
SITE_URL=https://твой-сайт.vercel.app

# Закрыть регистрацию автоматически (необязательно, ISO-формат)
REGISTRATION_DEADLINE=2026-11-22T23:59:00+03:00
